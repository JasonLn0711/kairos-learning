{
  "schema_version": 1,
  "root": ".",
  "checks": [
    {
      "rule": "json",
      "paths": [
        "package.json"
      ]
    },
    {
      "rule": "parity",
      "source": "site",
      "destination": "build",
      "exclude": [
        "index.html"
      ]
    },
    {
      "rule": "artifact",
      "path": "build"
    },
    {
      "rule": "html",
      "path": "build",
      "site": "https://learn.cs-kairos.com"
    }
  ]
}
