      {
        "title": "UDP: independent datagrams",
        "body": [
          "Datagram A",
          "Datagram B",
          "Datagram C",
          "Datagram A",
          "Lost",
          "Datagram C"
        ]
      }
    ],
    "labels": [
      "Lost → retransmitted",
      "B lost; UDP does not retransmit it"
    ],
    "footer": [
      {
        "title": "TCP delivery",
        "body": [
          "The application reads ordered bytes",
          "One read need not match one write",
