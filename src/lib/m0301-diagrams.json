      },
      {
        "title": "Application login",
        "body": [
          "Check account, credentials and permissions"
        ]
      }
    ]
  },
  "/images/ceh/m03-01-03-transport-models-en.svg": {
    "layout": "transport",
    "caption": "TCP is a byte stream; UDP carries independent datagrams",
    "description": "Compare interfaces and guarantees, not a blanket claim that one is always faster.",
    "nodes": [
      {
        "title": "TCP: ordered byte stream",
        "body": [
          "Segment 1",
          "Segment 2",
          "Segment 3",
          "1",
          "2",
          "3"
