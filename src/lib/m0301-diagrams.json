  "/images/ceh/m03-01-02-tcp-and-application-en.svg": {
    "layout": "handshake",
    "caption": "TCP: establish state, then deliver ordered data",
    "description": "SYN / SYN-ACK / ACK establish transport state, not encryption or website login.",
    "nodes": [
      {
        "title": "SYN",
        "body": [
          "Client → Server",
          "Synchronize client initial sequence number"
        ]
      },
      {
        "title": "SYN + ACK",
        "body": [
          "Server → Client",
          "Supply server sequence number and acknowledge SYN"
        ]
      },
      {
        "title": "ACK",
        "body": [
          "Client → Server",
          "Acknowledge the server SYN"
        ]
      }
    ],
    "labels": [
      "Client",
      "Server"
    ],
    "footer": [
      {
        "title": "TCP transport",
        "body": [
