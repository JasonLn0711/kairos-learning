  "environment": {
    "title": {
      "zh": "從依賴規格到已安裝環境",
      "en": "From dependency requirements to an installed environment"
    },
    "nodes": [
      {
        "zh": {
          "title": "Manifest",
          "body": "允許哪些依賴"
        },
        "en": {
          "title": "Manifest",
          "body": "Which dependencies are allowed"
        }
      },
      {
        "zh": {
          "title": "Lockfile",
          "body": "選定哪些版本"
        },
        "en": {
          "title": "Lockfile",
          "body": "Which versions were selected"
        }
      },
      {
        "zh": {
          "title": "Installed Environment（已安裝環境）",
          "body": "磁碟上真正存在的程式、模組、入口與連結"
        },
        "en": {
          "title": "Installed Environment",
          "body": "Programs, modules, entry points and links actually on disk"
        }
      }
    ],
    "note": {
      "zh": "需求規格、解析結果與實際安裝狀態需要分別核對。",
      "en": "Check requirements, resolution results and actual installation separately."
    }
  },
  "docker": {
    "title": {
      "zh": "Docker 的典型分層儲存概念",
      "en": "Typical layered Docker storage"
    },
    "nodes": [
      {
        "zh": {
          "title": "Container Writable Layer",
          "body": "容器執行時新增或修改的狀態"
        },
        "en": {
          "title": "Container Writable Layer",
          "body": "State added or changed while the container runs"
        }
      },
      {
        "zh": {
          "title": "Application Layer",
          "body": "應用程式及相關檔案"
        },
        "en": {
          "title": "Application Layer",
          "body": "Application and related files"
        }
      },
      {
        "zh": {
          "title": "Dependency Layers",
          "body": "執行環境與套件"
        },
        "en": {
          "title": "Dependency Layers",
          "body": "Runtimes and packages"
        }
      },
      {
        "zh": {
          "title": "Base Image Layers",
          "body": "基底檔案系統內容"
        },
        "en": {
          "title": "Base Image Layers",
          "body": "Base filesystem contents"
        }
      },
      {
        "zh": {
          "title": "Volume / Bind Mount",
          "body": "獨立於容器可寫層管理的持久資料"
        },
        "en": {
          "title": "Volume / Bind Mount",
          "body": "Persistent data managed outside the writable layer"
        }
      }
    ],
    "note": {
      "zh": "示意結構。多個映像可共用相同層，因此映像列表大小不能直接加總為實際唯一磁碟占用。",
      "en": "Conceptual structure. Images may share layers; listed image sizes cannot simply be summed as unique disk usage."
    }
  },
  "git-areas": {
    "title": {
      "zh": "Git 的三個主要工作區域",
      "en": "Three main Git working areas"
    },
    "nodes": [
      {
        "zh": {
          "title": "Working Tree",
          "body": "正在修改的檔案"
        },
        "en": {
