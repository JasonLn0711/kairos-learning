{
  "lifecycle": {
    "title": {
      "zh": "軟體從開發到交付的完整生命週期",
      "en": "The software lifecycle from source to delivery"
    },
    "nodes": [
      {
        "zh": {
          "title": "Source（來源）",
          "body": "程式碼、資料、設定、需求"
        },
        "en": {
          "title": "Source",
          "body": "Code, data, configuration, requirements"
        }
      },
      {
        "zh": {
          "title": "Dependency（依賴）",
          "body": "套件、版本、函式庫、工具鏈"
        },
        "en": {
          "title": "Dependency",
          "body": "Packages, versions, libraries, toolchain"
        }
      },
      {
        "zh": {
          "title": "Build / Execute（建置與執行）",
          "body": "作業系統、程序、編譯器、執行環境"
        },
        "en": {
          "title": "Build / Execute",
          "body": "OS, processes, compilers, runtimes"
        }
      },
      {
        "zh": {
          "title": "Artifact（成品）",
          "body": "網站檔案、執行檔、容器映像、模型封裝"
        },
        "en": {
          "title": "Artifact",
          "body": "Website files, executables, images, model packages"
        }
      },
      {
        "zh": {
          "title": "Deploy / Serve（部署與服務）",
          "body": "伺服器、容器、網路、瀏覽器"
        },
        "en": {
          "title": "Deploy / Serve",
          "body": "Servers, containers, networks, browsers"
        }
      },
      {
        "zh": {
          "title": "Verification（驗證）",
          "body": "檢查每個階段，並確認使用者得到正確結果"
        },
        "en": {
          "title": "Verification",
          "body": "Check every stage and the result users receive"
        }
      }
    ],
    "note": {
      "zh": "檔案系統與硬體支撐所有階段；Git 管理來源歷史；測試、安全與證據追溯貫穿整條流程。",
      "en": "Filesystems and hardware support every stage; Git manages source history. Testing, security and provenance span the whole flow."
    }
  },
  "hardware": {
    "title": {
      "zh": "CPU、RAM、SSD 與 GPU 的角色",
      "en": "CPU, RAM, SSD and GPU roles"
    },
    "nodes": [
      {
        "zh": {
          "title": "CPU",
          "body": "執行指令、運算與控制"
        },
        "en": {
          "title": "CPU",
          "body": "Executes instructions, computation and control"
        }
      },
      {
        "zh": {
          "title": "RAM",
          "body": "暫存程序正在使用的資料"
        },
        "en": {
          "title": "RAM",
          "body": "Holds data currently used by processes"
        }
      },
      {
        "zh": {
          "title": "SSD",
          "body": "持久保存檔案與程式"
        },
        "en": {
          "title": "SSD",
          "body": "Persistently stores files and programs"
        }
      },
      {
        "zh": {
          "title": "GPU",
          "body": "大量平行計算，常用於圖形與 AI"
        },
        "en": {
          "title": "GPU",
          "body": "Parallel computation for graphics and AI"
        }
      }
    ],
    "note": {
      "zh": "儲存層共享與執行期記憶體共享是不同機制。",
      "en": "Storage sharing and runtime memory sharing are separate mechanisms."
    }
  },
