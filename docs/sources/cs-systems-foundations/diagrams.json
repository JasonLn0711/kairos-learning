          "body": "Files being edited"
        }
      },
      {
        "zh": {
          "title": "Index",
          "body": "準備提交的內容"
        },
        "en": {
          "title": "Index",
          "body": "Content prepared for a commit"
        }
      },
      {
        "zh": {
          "title": "Repository",
          "body": "已提交的版本物件"
        },
        "en": {
          "title": "Repository",
          "body": "Committed version objects"
        }
      }
    ],
    "note": {
      "zh": "Working Tree → git add → Index → git commit → Repository。工作樹、暫存區與已提交資料是不同狀態。",
      "en": "Working Tree → git add → Index → git commit → Repository. These are distinct states."
    }
  },
