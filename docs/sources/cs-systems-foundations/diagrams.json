          "title": "link inode",
          "body": "stored path: target.txt"
        }
      },
      {
        "zh": {
          "title": "target.txt",
          "body": "resolve path"
        },
        "en": {
          "title": "target.txt",
          "body": "resolve path"
        }
      },
      {
        "zh": {
          "title": "target inode",
          "body": "目標檔案物件"
